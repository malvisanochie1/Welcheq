generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FAMILY
  CAREGIVER
  PATIENT
  AGENCY_ADMIN
}

enum OrganizationRole {
  ADMIN
  COORDINATOR
  CAREGIVER
}

enum CareRelationship {
  OWNER
  FAMILY_VIEWER
  CAREGIVER
  SELF
}

enum CareTaskCategory {
  MEDICATION
  VITALS
  PERSONAL_CARE
  MEAL
  MOBILITY
  OTHER
}

enum TaskOutcome {
  DONE
  NOT_DONE
}

enum AttendanceFlag {
  LATE_ARRIVAL
  EARLY_DEPARTURE
  MOCK_LOCATION
  RECORDED_OFFLINE
  CHECKED_OUT_AWAY
}

enum ProofMethod {
  LOCATION
  SELFIE
  ROTATING_CODE
  SURPRISE_CHECK
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String
  phone     String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         OrganizationMember[]
  patientAccess       PatientAccess[]
  patientsCreated     Patient[]            @relation("PatientCreatedBy")
  auditEvents         AuditEvent[]
  invitationsSent     Invitation[]         @relation("InvitationCreatedBy")
  invitationsAccepted Invitation[]         @relation("InvitationAcceptedBy")
  careTasksCreated    CareTask[]
  taskRecords         TaskRecord[]
  shiftsAssigned      Shift[]              @relation("ShiftCaregiver")
  shiftsCreated       Shift[]              @relation("ShiftCreatedBy")
  visits              Visit[]              @relation("VisitCaregiver")
  openVisit           Visit?               @relation("OpenVisit")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  OrganizationMember[]
  patients Patient[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Patient {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String?       @db.Uuid
  createdById          String        @db.Uuid
  fullName             String
  dateOfBirth          DateTime?     @db.Date
  homeAddress          String
  homeLatitude         Float
  homeLongitude        Float
  geofenceRadiusMeters Int           @default(150)
  proofMethods         ProofMethod[] @default([LOCATION])
  timeZone             String        @default("Africa/Lagos")
  homeCodeSecret       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  archivedAt           DateTime?

  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  access          PatientAccess[]
  invitations     Invitation[]
  careTasks       CareTask[]
  taskRecords     TaskRecord[]
  shifts          Shift[]
  visits          Visit[]
  displayPairings HomeDisplayPairing[]

  @@index([organizationId])
  @@map("patients")
}

model PatientAccess {
  id           String           @id @default(uuid()) @db.Uuid
  patientId    String           @db.Uuid
  userId       String           @db.Uuid
  relationship CareRelationship
  grantedById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  revokedAt    DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([patientId, userId])
  @@index([userId])
  @@map("patient_access")
}

model Invitation {
  id           String           @id @default(uuid()) @db.Uuid
  patientId    String           @db.Uuid
  relationship CareRelationship
  codeHash     String           @unique
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now())
  expiresAt    DateTime
  acceptedById String?          @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("invitations")
}

model CareTask {
  id                   String           @id @default(uuid()) @db.Uuid
  patientId            String           @db.Uuid
  title                String
  category             CareTaskCategory
  instructions         String?
  minutesAfterMidnight Int
  daysOfWeek           Int[]
  createdById          String           @db.Uuid
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  archivedAt           DateTime?

  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  records   TaskRecord[]

  @@index([patientId, archivedAt])
  @@map("care_tasks")
}

model TaskRecord {
  id           String      @id @default(uuid()) @db.Uuid
  careTaskId   String      @db.Uuid
  patientId    String      @db.Uuid
  dueDate      DateTime    @db.Date
  outcome      TaskOutcome
  note         String?
  recordedById String      @db.Uuid
  recordedAt   DateTime    @default(now())

  careTask   CareTask @relation(fields: [careTaskId], references: [id], onDelete: Cascade)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([careTaskId, dueDate])
  @@index([patientId, dueDate])
  @@map("task_records")
}

model Shift {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  caregiverId String    @db.Uuid
  seriesId    String?   @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver User    @relation("ShiftCaregiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ShiftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  visits    Visit[]

  @@index([patientId, startsAt])
  @@index([caregiverId, startsAt])
  @@map("shifts")
}

model Visit {
  id                     String           @id @default(uuid()) @db.Uuid
  patientId              String           @db.Uuid
  caregiverId            String           @db.Uuid
  shiftId                String?          @db.Uuid
  /// Set to the caregiver while the visit is open; the unique constraint allows one open visit each.
  openForCaregiverId     String?          @unique @db.Uuid
  checkInAt              DateTime
  checkInClientAt        DateTime
  checkInLatitude        Float
  checkInLongitude       Float
  checkInAccuracyMeters  Float
  checkInDistanceMeters  Float
  checkOutAt             DateTime?
  checkOutClientAt       DateTime?
  checkOutLatitude       Float?
  checkOutLongitude      Float?
  checkOutAccuracyMeters Float?
  checkOutDistanceMeters Float?
  flags                  AttendanceFlag[]
  homeCodeVerified       Boolean          @default(false)
  createdAt              DateTime         @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiver     User           @relation("VisitCaregiver", fields: [caregiverId], references: [id], onDelete: Cascade)
  openFor       User?          @relation("OpenVisit", fields: [openForCaregiverId], references: [id], onDelete: SetNull)
  shift         Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  surpriseCheck SurpriseCheck?

  @@index([patientId, checkInAt])
  @@index([caregiverId, checkInAt])
  @@index([shiftId])
  @@map("visits")
}

model SurpriseCheck {
  id             String    @id @default(uuid()) @db.Uuid
  visitId        String    @unique @db.Uuid
  dueAt          DateTime
  respondedAt    DateTime?
  passed         Boolean?
  distanceMeters Float?
  isMocked       Boolean   @default(false)

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@map("surprise_checks")
}

model HomeDisplayPairing {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  codeHash    String    @unique
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("home_display_pairings")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_events")
}
