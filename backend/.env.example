NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Connection used by the running API (Supabase: Connect → Session pooler)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# Connection used for migrations (Supabase: Connect → Session pooler; same value is fine)
DIRECT_DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Supabase project URL; access tokens are verified against its public signing keys
SUPABASE_URL=https://your-project.supabase.co

# Server-only key for private photo storage (selfies). Never put this in the app.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:8081
