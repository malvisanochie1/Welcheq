NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Pooled connection used by the running API (Supabase: Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection used only for migrations (Supabase: Session pooler, port 5432)
DIRECT_DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Supabase project URL; access tokens are verified against its public signing keys
SUPABASE_URL=https://your-project.supabase.co

# Comma-separated web origins allowed to call the API
CORS_ORIGINS=http://localhost:8081
