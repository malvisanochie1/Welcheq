{
  "expo": {
    "name": "Welcheq",
    "slug": "welcheq",
    "owner": "malvis",
    "scheme": "welcheq",
    "version": "0.3.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.welcheq.app"
    },
    "android": {
      "package": "ng.welcheq.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F5C5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Welcheq to use Face ID to sign you in."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8F7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Welcheq uses your location to confirm visits happen at the patient’s home.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Welcheq uses the camera for the check-in selfie the family asked for.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5640c8bd-d7aa-4227-b450-bde6483ade57"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5640c8bd-d7aa-4227-b450-bde6483ade57"
    }
  }
}
