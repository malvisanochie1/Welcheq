{
  "expo": {
    "name": "Welcheq",
    "slug": "welcheq",
    "owner": "malvis",
    "scheme": "welcheq",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.welcheq.app"
    },
    "android": {
      "package": "ng.welcheq.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F5C5A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F8F7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5640c8bd-d7aa-4227-b450-bde6483ade57"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5640c8bd-d7aa-4227-b450-bde6483ade57"
    }
  }
}
